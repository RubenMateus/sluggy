<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Description>
      SluggyUnidecode is a powerful slugifier designed to create friendly URL's. Simple and powerful.
      Extends the Sluggy package by using the Unidecode.Net library for normalization.
    </Description>
    <Authors>Ruben Mateus</Authors>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Copyright>Copyright (c) 2020 Ruben Mateus</Copyright>
    <RepositoryUrl>https://github.com/RubenMateus/sluggy</RepositoryUrl>
    <RepositoryType>Library</RepositoryType>
    <PackageTags>slug simple normalization url friendly generator normalizer urls slugs unidecode</PackageTags>
    <PackageReleaseNotes>See https://github.com/RubenMateus/sluggy/releases</PackageReleaseNotes>
    <Version>2.0.1</Version>
    <!-- Set by the release workflow; a package-specific name keeps it from flowing into referenced projects like /p:Version would. -->
    <Version Condition="'$(SluggyUnidecodeVersion)' != ''">$(SluggyUnidecodeVersion)</Version>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>sluggyUnidecode.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sluggy\Sluggy.csproj" />
    <PackageReference Include="Unidecode.NET" Version="2.1.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\sluggyUnidecode.png">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
  </ItemGroup>
</Project>